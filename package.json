{
	"name": "kenja2-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"cloud-build": "npm install && npm run build",
		"prepare": "svelte-kit sync || echo ''",
