		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.1",
		"@sveltejs/kit": "^2.37.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^24.3.1",
		"daisyui": "^5.1.8",
		"svelte": "^5.38.7",
		"svelte-check": "^4.3.1",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vite": "^6.3.5"
	},
	"dependencies": {
		"@aws-sdk/client-lambda": "^3.883.0",
		"pino": "^9.9.4"
	}
}
